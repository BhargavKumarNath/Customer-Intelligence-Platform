# Virtual Environments
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# LARGE DATA FILES (LOCAL ONLY)
# Full database (5+ GB)
data/db/
data/db/**

# Raw CSV files (12+ GB)
data/raw/
data/raw/**
*.csv

# Processed intermediate files
data/processed/
data/processed/**

# Keep ONLY sample data for cloud (these ARE uploaded)
!data/sample/
!data/sample/*.parquet

# Exclude .duckdb files (not portable across Windows/Linux)
data/sample/*.duckdb

# Machine Learning Models (exclude large trained models)
src/models/*.pkl
src/models/*.joblib
src/models/*.h5
src/models/*.pth
*.model

# ...except the checked-in propensity model: it can't be regenerated in CI/Docker
# (training needs the full 12GB raw dataset), and it's small (~3.4MB).
!src/models/propensity_lgbm.pkl

# Generated Outputs and Logs
logs/
logs/**
outputs/
outputs/**
analysis_subsets/
analysis_subsets/**
*.log

