# Local Configuration (secrets and local configs)
.streamlit/secrets.toml
config/config.local.yaml
.env
.env.local
.env.*.local
!.env.example
*.secret
FIRST_ROUND_PREP.md

# Temporary Files 
*.tmp
.tmp/
temp/
*.bak
*.swp

.devcontainer/
interview/

# ---------------------------------------------------------------------------
# Deployment migration (Stack E — see DEPLOYMENT_ARCHITECTURE_REVIEW.md /
# deployment_stages.md). Added in Phase 0; frontend/cloud dirs land in Phase 4+.
# ---------------------------------------------------------------------------

# Phase 0 spike — throwaway (bundles a 32 MB parquet + node_modules)
spike/

# Extra coverage / test-report artifacts (Python .coverage + htmlcov already covered above)
coverage.xml
.coverage.*
coverage/

# Security scanners (Phase 1) — local run caches; CI runs these inside throwaway containers
.trivycache/
.trivy/

# Frontend (Next.js) — Phase 4+
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.eslintcache
playwright-report/
test-results/
.lighthouseci/
.lighthouseci
# Generated at build time from dist/data/<sha>/ by frontend/scripts/{fetch,sync}-data.mjs.
# Pinned per commit; produced by the precompute pipeline, never hand-edited.
frontend/public/data/
# These frontend files ARE tracked (do not add ignores for them):
#   frontend/data.lock                          - the data-set pin
#   frontend/src/lib/__fixtures__/ab_cases.json - A/B parity fixture, CI fails on drift

# Cloud / deploy tooling local state — never commit credentials or provider caches
.vercel/
.wrangler/
.gcloud/
gha-creds-*.json
*service-account*.json
*.gserviceaccount.json


DEPLOYMENT_ARCHITECTURE_REVIEW.md
deployment_stages.md
.gitignore