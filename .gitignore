# Virtual Environments
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# LARGE DATA FILES (LOCAL ONLY)
# Full DuckDB database (~5.4 GB) + its on-disk spill dir
data/db/
data/db/**

# Raw Kaggle CSVs (~13.7 GB: data/2019-Oct.csv + data/2019-Nov.csv) and the
# optimised Parquet built from them (summarise/optimize_dataset.py -> data/raw/).
data/raw/
data/raw/**
*.csv

# Processed / pre-aggregated intermediates
data/processed/
data/processed/**
data/analysis_subsets/
data/analysis_subsets/**

# DuckDB out-of-core spill / temp dirs (src/utils/duckdb_env.py,
# summarise/optimize_dataset.py). Can appear next to any .duckdb file.
.duckdb_spill/
.duckdb_tmp/
**/.duckdb_spill/
**/.duckdb_tmp/

# Keep ONLY sample data for cloud (these ARE uploaded)
!data/sample/
!data/sample/*.parquet

# Exclude .duckdb files (not portable across Windows/Linux)
data/sample/*.duckdb

# Machine Learning Models (exclude large trained models)
src/models/*.pkl
src/models/*.joblib
src/models/*.h5
src/models/*.pth
src/models/*.txt
*.model

# ...except the checked-in propensity model: it can't be regenerated in CI/Docker
# (training needs the full ~13.7GB raw dataset), and it's small (~3.5MB, 998 trees,
# trained on the full 109.95M-row dataset). propensity_lgbm.txt is LightGBM's
# native text format (Phase 3 task 6); the .pkl is kept for one release as a
# load fallback and is removed in a later phase.
!src/models/propensity_lgbm.pkl
!src/models/propensity_lgbm.txt

# Generated Outputs and Logs
logs/
logs/**
logs_pipeline/
logs_pipeline/**
outputs/
outputs/**
analysis_subsets/
analysis_subsets/**
*.log

# Local pipeline-run record (regenerated per full-dataset run; not public repo doc)
PIPELINE_RUN_REPORT.md

# Python Cache and Bytecode
__pycache__/
__pycache__/**
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# IDE and Editor Files
.vscode/
.idea/
.claude/

# Local-only docs (deployment/setup notes, kept out of the public repo)
docs/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

